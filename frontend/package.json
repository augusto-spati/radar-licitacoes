{
  "name": "radar-licitacoes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "duplicacao": "jscpd src --ignore \"**/api.d.ts\"",
    "contrato": "openapi-typescript openapi.json -o src/dados/api.d.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@stylexjs/stylex": "^0.19.2",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@stylexjs/unplugin": "^0.19.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.4.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
