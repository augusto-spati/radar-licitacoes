  "paths": {
    "/api/analises/{id_publico}": {
      "get": {
        "description": "Exigências extraídas por IA e comparadas com o perfil (modelo padrão).",
        "operationId": "analise_api_analises__id_publico__get",
        "parameters": [
          {
            "in": "path",
            "name": "id_publico",
            "required": true,
            "schema": {
              "title": "Id Publico",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnaliseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analise"
      }
    },
